{
  "name": "@ahmadmoussawi/webdb",
  "version": "0.2.3",
  "type": "module",
  "description": "Ultra-lean browser-native relational database engine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmad-moussawi/webdb.git"
  },
  "keywords": [
    "database",
    "browser-database",
    "sql",
    "indexeddb",
    "opfs",
    "wasm",
    "btree",
    "wal",
    "acid"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/webdb.umd.cjs",
  "module": "./dist/webdb.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/webdb.js",
      "require": "./dist/webdb.umd.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js",
      "require": "./dist/angular.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    }
  },
  "peerDependencies": {
    "@angular/core": ">=16.0.0",
    "react": ">=18.0.0",
    "rxjs": ">=7.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate:layouts": "node scripts/generate_layouts.js",
    "transpile:c": "vite-node scripts/transpiler/index.ts --all --write",
    "build:wasm": "node scripts/build_wasm.js",
    "prebuild": "node scripts/generate_layouts.js",
    "build": "vite build && vite build --config vite.adapters.config.ts",
    "prepack": "npm run build",
    "pretest": "node scripts/generate_layouts.js",
    "test": "vitest run",
    "test:js": "vitest run --project js",
    "test:wasm": "vitest run --project wasm",
    "test:e2e": "playwright test",
    "release:alpha": "npm version prerelease --preid=alpha && git push && git push --tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "demo": "vite-node examples/demo.ts",
    "playground": "vite --config vite.playground.config.ts",
    "playground:serve": "node scripts/serve.js",
    "build:playground": "vite build --config vite.playground.config.ts",
    "benchmark": "vite --config vite.benchmark.config.ts",
    "build:benchmark": "vite build --config vite.benchmark.config.ts",
    "docs:prepare": "npm run build && npm run build:playground && npm run build:benchmark && node scripts/prepare_docs_playground.js",
    "docs:dev": "npm run build:playground && npm run build:benchmark && node scripts/prepare_docs_playground.js && vitepress dev docs",
    "docs:build": "npm run docs:prepare && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.63.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.0.0",
    "lucide-react": "^1.48.0",
    "markdown-it-mathjax3": "^4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tinybench": "^6.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^5.1.1",
    "vitepress": "^1.5.0",
    "vitest": "^3.0.0"
  }
}
